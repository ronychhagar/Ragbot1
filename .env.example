# LLM Configuration
LLM_MODEL=mistral
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.9
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60
LLM_RETRY_ATTEMPTS=3

# Vector Database Configuration
VECTOR_DB_PATH=chroma_db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# RAG Configuration
TOP_K=5
TOP_K_RERANK=3
SIMILARITY_THRESHOLD=0.5

# Document Chunking
CHUNK_SIZE=1024
CHUNK_OVERLAP=200
CHUNK_SEPARATOR="\n\n"

# Document Loading
DOCS_PATH=data
SUPPORTED_FORMATS=.pdf,.txt,.md,.docx

# Chat Configuration
MAX_CHAT_HISTORY=20
MAX_CONTEXT_LENGTH=4000
ENABLE_MEMORY=true

# Performance
CACHE_ENABLED=true
CACHE_TTL=3600
BATCH_SIZE=32

# Logging
LOG_LEVEL=INFO
LOG_FILE=rag_bot.log
ENABLE_FILE_LOGGING=true
